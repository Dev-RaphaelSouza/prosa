{
  "name": "prosa",
  "private": true,
  "version": "0.1.0",
  "description": "App de conversa para grupos de amigos: canais de texto e voz, chamadas com vídeo e tela, e um navegador compartilhado.",
  "license": "MIT",
  "keywords": ["chat", "webrtc", "websocket", "react", "typescript", "sqlite"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-RaphaelSouza/prosa.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
